<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:BibleRecallTrainerV2.ViewModels"
             xmlns:models="clr-namespace:BibleRecallTrainerV2.Models"
             x:Class="BibleRecallTrainerV2.StudyPlanPage"
             x:DataType="viewModels:StudyPlanViewModel"
             Title="Study Plan">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="Daily study plan" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource Primary}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Choose a realistic daily chapter goal. Progress is calculated from reading completed on this device." />

            <Border Stroke="{DynamicResource ThemeBorder}" StrokeShape="RoundRectangle 14" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Daily chapter goal" FontAttributes="Bold" FontSize="18" />
                    <Stepper Minimum="1" Maximum="5" Increment="1" Value="{Binding DailyChapterGoal}" />
                    <Label Text="{Binding GoalText}" FontSize="16" />
                    <Label Text="{Binding Summary}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Reviews due" FontAttributes="Bold" FontSize="20" />
            <CollectionView ItemsSource="{Binding DueReviews}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Nothing is due yet. Complete a quiz to start your review schedule." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StudyChapterItem">
                        <Border Stroke="{DynamicResource ThemeBorder}" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="16" />
                                <Label Grid.Row="1" Text="{Binding DueText}" />
                                <Button Grid.Column="1" Grid.RowSpan="2" Text="Review"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:StudyPlanViewModel}}, Path=OpenReviewCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="DarkRed" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
