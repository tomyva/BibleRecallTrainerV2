<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BibleRecallTrainerV2.RecallPage"
             Title="Voice Recall">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Reference}" FontSize="28" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding Position}" TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Listen" Command="{Binding ListenCommand}" SemanticProperties.Description="Listen to the current verse" />
            </Grid>

            <Border Stroke="{DynamicResource ThemeBorder}" StrokeShape="RoundRectangle 14" Padding="18" MinimumHeightRequest="130">
                <Grid>
                    <Label Text="{Binding CanonicalText}" IsVisible="{Binding IsCanonicalVisible}" FontSize="19" LineHeight="1.4" LineBreakMode="WordWrap" />
                    <VerticalStackLayout IsVisible="{Binding IsVerseHidden}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                        <Label Text="Verse hidden" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Recite it from memory." HorizontalTextAlignment="Center" TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{Binding ToggleVerseText}" Command="{Binding ToggleVerseCommand}" />
                <Button Grid.Column="1" Text="Start Recall" Command="{Binding StartRecallCommand}" BackgroundColor="#2E7D32" SemanticProperties.Description="Start microphone voice recall" />
            </Grid>

            <Border Stroke="{DynamicResource Primary}" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <ActivityIndicator IsRunning="{Binding IsListening}" IsVisible="{Binding IsListening}" WidthRequest="24" HeightRequest="24" />
                        <Label Grid.Column="1" Text="{Binding Status}" FontAttributes="Bold" VerticalTextAlignment="Center" SemanticProperties.Description="{Binding Status}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Stop" Command="{Binding StopRecallCommand}" SemanticProperties.Description="Stop and process voice recall" />
                        <Button Grid.Column="1" Text="Cancel" Command="{Binding CancelRecallCommand}" BackgroundColor="{StaticResource Gray600}" SemanticProperties.Description="Cancel voice recall" />
                    </Grid>
                    <Button Text="Open App Settings" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding CanOpenSettings}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="6">
                <Label Text="Recognized transcript" FontSize="17" FontAttributes="Bold" />
                <Border Stroke="{DynamicResource ThemeBorder}" StrokeShape="RoundRectangle 12" Padding="14" MinimumHeightRequest="90">
                    <Label Text="{Binding Transcript}" FontSize="17" LineHeight="1.35" LineBreakMode="WordWrap" />
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Reveal &amp; Compare" Command="{Binding RevealAndCompareCommand}" />
                    <Button Grid.Column="1" Text="Clear" Command="{Binding ClearTranscriptCommand}" BackgroundColor="{StaticResource Gray600}" />
                </Grid>
            </VerticalStackLayout>

            <Border IsVisible="{Binding HasComparison}" Stroke="{DynamicResource ThemeBorder}" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Comparison" FontSize="19" FontAttributes="Bold" />
                    <Label Text="{Binding ComparisonFeedback}" FontSize="16" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Differences}" Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFF4E5, Dark=#4A3822}" Padding="10,6" StrokeShape="RoundRectangle 7">
                                    <Label Text="{Binding Description}" LineBreakMode="WordWrap" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="No differences found." IsVisible="{Binding IsExactMatch}" FontAttributes="Italic" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Try Again" Command="{Binding TryAgainCommand}" />

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                <Button Text="Previous Verse" Command="{Binding PreviousVerseCommand}" />
                <Button Grid.Column="1" Text="Back" Command="{Binding BackCommand}" BackgroundColor="{StaticResource Gray600}" />
                <Button Grid.Column="2" Text="Next Verse" Command="{Binding NextVerseCommand}" />
            </Grid>

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#B3261E" />
            <Label Text="Speech recognition may use the device provider’s online service. Audio is not stored by Bible Recall Trainer." FontSize="12" TextColor="{StaticResource Gray500}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
